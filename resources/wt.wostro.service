[Unit]
Description=wt.wostro
Wants=network-online.target
After=network-online.target

[Service]
LimitCORE=infinity
WorkingDirectory=/home/pvn/nostr_client_relay/build/web
Environment="LD_LIBRARY_PATH=/home/pvn/nostr_client_relay/ext/boost_1_88_0/stage/lib"
ExecStart=/home/pvn/nostr_client_relay/build/web/wostro --http-address=0.0.0.0 --http-port=8080 \
 --docroot=/home/pvn/nostr_client_relay/build/web \
 --resources-dir=/home/pvn/nostr_client_relay/build/web/ \
 --accesslog=/home/pvn/nostr_client_relay/build/web/wt.log.txt
User=pvn

[Install]
WantedBy=multi-user.target
